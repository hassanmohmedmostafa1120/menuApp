{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build lab1",
            "type": "shell",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "src/main.cpp",
                "src/readhelper.cpp",
                "src/termtext.cpp",
                "-o",
                "app"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compile src/*.cpp into ./app"
        },
        {
            "label": "Run lab1",
            "type": "shell",
            "command": "./app",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build lab1",
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": [],
            "detail": "Build, then run in VS Code's terminal"
        },
        {
            "label": "Run lab1 (external terminal)",
            "type": "process",
            "command": "ptyxis",
            "args": [
                "--title=lab1",
                "--",
                "bash",
                "-c",
                "\"${workspaceFolder}/app\"; echo; read -n 1 -s -r -p 'Press any key to close...'"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build lab1",
            "problemMatcher": [],
            "detail": "Build, then run in a separate Ptyxis window"
        }
    ]
}