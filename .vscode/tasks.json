{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "Build lab1",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-g",
                "${workspaceFolder}/src/*.cpp",
                "-o",
                "${workspaceFolder}/app"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Compile every .cpp file in src/ into ./app"
        },
        {
            "type": "shell",
            "label": "Run lab1",
            "command": "${workspaceFolder}/app",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build lab1",
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Build, then run inside VS Code's terminal"
        },
        {
            "type": "process",
            "label": "Run lab1 (external window)",
            "command": "ptyxis",
            "args": [
                "--title=lab1",
                "--",
                "bash",
                "-c",
                "\"${workspaceFolder}/app\"; echo; read -n 1 -s -r -p 'Press any key to close...'"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Build lab1",
            "problemMatcher": [],
            "group": "build",
            "detail": "Build, then run in a Ptyxis window"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++-15 build active file",
            "command": "/usr/bin/g++-15",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}